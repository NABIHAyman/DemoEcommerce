{% extends 'base.html.twig' %}

{% block title %}Browse Categories | Minimalist Store{% endblock %}

{% block body %}
    <div class="mb-8">
        <h2 class="text-4xl font-light tracking-tight text-slate-900 dark:text-white">Browse Categories</h2>
        <p class="mt-2 text-slate-500 dark:text-slate-400 text-sm">Explore our collections by category.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for category in categories %}
            <a href="{{ path('app_products_by_category', {'id': category.id}) }}"
               class="group bg-white dark:bg-slate-800 rounded-sm shadow-[0_4px_6px_rgba(0,0,0,0.05)] hover:shadow-xl transition-all overflow-hidden flex flex-col h-full border border-slate-100 dark:border-slate-700 hover:border-primary/30">
                <div class="relative aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-700">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                         src="https://picsum.photos/seed/cat{{ category.id }}/600/340"
                         alt="{{ category.name }}">
                </div>
                <div class="p-6 flex flex-col grow">
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                        {{ category.name }}
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
                        {{ category.products|length }} product{{ category.products|length > 1 ? 's' : '' }}
                    </p>
                    <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold uppercase tracking-widest text-primary">
                        View products
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </span>
                </div>
            </a>
        {% else %}
            <div class="col-span-full py-20 text-center text-slate-500">
                <span class="material-symbols-outlined text-5xl mb-4 opacity-30">category</span>
                <h3 class="text-xl font-bold mb-2">No categories found</h3>
                <p>Categories will appear here once they are added to the catalog.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
